{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anything Lite",
  "identifier": "com.anything.lite",
  "build": {
    "beforeDevCommand": "pnpm dev:lite",
    "beforeBuildCommand": "pnpm build:lite"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: asset: https://asset.localhost; connect-src 'self'; object-src 'none'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "resources": [
      "resources/node.exe",
      "resources/kordoc/**/*",
      "icons/tray-icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": []
    }
  }
}
